根据下拉框去限制显示预算实体的属性为下拉框的excel公式
下拉框的单元格为$B$2
需要在$B$3列写出如下公式
=IF($B$2="合计",
  "[S_预算实体].[S_预算实体].[U09_预算实体]",
  IF($B$2="制费",
    "Filter([S_预算实体].[S_预算实体].[U09_预算实体], [S_预算实体].[S_预算实体].CurrentMember.Properties(""费用类型"") = ""直接生产"" OR [S_预算实体].[S_预算实体].CurrentMember.Properties(""费用类型"") = ""间接生产"")",
    IF($B$2="期费",
      "Filter([S_预算实体].[S_预算实体].[U09_预算实体], [S_预算实体].[S_预算实体].CurrentMember.Properties(""费用类型"") = ""销售"" OR [S_预算实体].[S_预算实体].CurrentMember.Properties(""费用类型"") = ""管理"" OR [S_预算实体].[S_预算实体].CurrentMember.Properties(""费用类型"") = ""研发"")",
      "Filter([S_预算实体].[S_预算实体].[U09_预算实体], [S_预算实体].[S_预算实体].CurrentMember.Properties(""费用类型"") = """ & $B$2 & """)"
    )
  )
)

然后在预算实体列使用如下公式
=TM1RPTROW($B$1, "服务器名:S_预算实体", "", "", "", "", $B$3)

如果下拉框是合计或者是全选或者是空的话就显示所有星启项目，否则根据下拉框显示项目的所属bu为下拉框的项目
=IF(OR($B$2="合计", $B$2="全选", $B$2=""),
  "[S_项目].[S_项目].[星启项目]",
  "Filter([S_项目].[S_项目].[星启项目], [S_项目].[S_项目].CurrentMember.Properties(""所属BU"") = """ & $B$2 & """)"
)

显示费用科目的科目大类_人力的属性为人力费用的元素
="Filter([S_费用科目].[S_费用科目].Members, [S_费用科目].[S_费用科目].CurrentMember.Properties(""科目大类_人力"") = ""人力费用"")"
