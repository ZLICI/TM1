#第三种方法，这个可以实现，并且速度飞快！
vDimension = 'S_预算实体';
# 1. 如果当前行是 0 级叶子（针对源数据直接录在叶子上的情况）
IF ( ELLEV(vDimension, S_预算实体) = 0 );
    CellPutS(值, vCubeTarget, S_预算实体, S_费用科目, vMeasure);

# 2. 如果当前行是父项（不管是第几层）
ELSE;
# ==========================================================
# 极致优化版：利用字符串队列进行子树向下遍历（告别全维度扫描）
# ==========================================================

# 初始化队列，将当前数据源的父项放入队列中（以 '|' 作为分隔符）
sQueue = S_预算实体 | '|';

WHILE( sQueue @<> '' );
    # 1. 从队列头部取出一个节点
    nPos = Scan( '|', sQueue );
    sCurrNode = SubSt( sQueue, 1, nPos - 1 );
    sQueue = SubSt( sQueue, nPos + 1, Long( sQueue ) - nPos );
    
    # 2. 获取当前节点的直接子节点数量
    nNumChildren = ElCompN( vDimension, sCurrNode );
    nI = 1;
    
    WHILE( nI <= nNumChildren );
        sChild = ElComp( vDimension, sCurrNode, nI );
        
        # 3. 判断子节点是 0 级明细还是合并项
        IF( ElLev( vDimension, sChild ) = 0 );
            # 如果是 0 级明细，直接写入目标 Cube
            CellPutS( 值, vCubeTarget, sChild, S_费用科目, vMeasure );
        ELSE;
            # 如果子节点本身还是合并项，将其追加到队列中继续向下遍历
            sQueue = sQueue | sChild | '|';
        ENDIF;
        
        nI = nI + 1;
    END;

END;
